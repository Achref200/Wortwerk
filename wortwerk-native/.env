# Firebase web configuration for the `Fritz` (Expo / React Native) web build.
#
# These are Firebase *client* identifiers: they are compiled into every web
# bundle and are public by design. Access is enforced by Firestore/Storage
# rules, not by hiding these values. Never put admin/service-account
# credentials in EXPO_PUBLIC_* variables.
#
# The app talks to the same Firebase project as the Flutter build, so both apps
# read identical content while you compare them.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_PROJECT_ID=wortwerk-35912
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDiv_5W4k27ckNn6_iTOJSF7YILPhkneYM
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=wortwerk-35912.firebaseapp.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=wortwerk-35912.firebasestorage.app
EXPO_PUBLIC_FIREBASE_SENDER_ID=199818141354
EXPO_PUBLIC_FIREBASE_APP_ID=1:199818141354:web:1a45b30e7e507ccd65bad3
